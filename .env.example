# ---- Site (Next.js on Vercel) ----
# Staging: your *.vercel.app URL. Launch: the custom domain (https://...).
NEXT_PUBLIC_SITE_URL=
# Staging-first: keep "true" until the custom domain is live and QA passes.
# Then set to "false" and redeploy to allow indexing.
NEXT_PUBLIC_NO_INDEX=true
# Server-side Supabase access (never NEXT_PUBLIC_ for the service key).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional display overrides
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_PHONE_TEL=

# ---- Pipeline (GitHub Actions secrets, same names) ----
XAI_API_KEY=
# xAI model id, e.g. grok-3 — check https://docs.x.ai for current names
GROK_MODEL=grok-3
